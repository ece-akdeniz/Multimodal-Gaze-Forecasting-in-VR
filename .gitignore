# keep data folder placeholders
!data/**/.gitkeep

# =========================
# PROCESSED DATA
# =========================

data/processed/**/*.npy
data/processed/**/*.csv

# =========================
# TRAINING OUTPUTS / MODELS
# =========================

results/**/*.npy
results/**/*.pt
results/**/*.pth
results/**/*.tar
results/**/model.pt

# keep small summaries/results if needed
!results/**/*.csv
!results/**/.gitkeep

# ignore detailed per-sample result csvs
results/**/*errors*.csv
results/gaze_anomalies.csv


docs/
Presentations/
notebooks/
report/

# =========================
# RAW DATASETS
# =========================

data/raw/D-SAV360/gaze/*
data/raw/D-SAV360/head/*
data/raw/D-SAV360/saliency/*
data/raw/D-SAV360/videos/*
data/raw/D-SAV360/audio/*
data/raw/D-SAV360/audio_energy_maps/*
